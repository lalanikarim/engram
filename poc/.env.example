# Copy this file to poc/.env and fill in the values.
# poc/.env is gitignored — never commit real secrets.

# --- Model endpoint (required by all PoC scripts) --------------------------
# Any OpenAI-compatible server: Unsloth Studio, vLLM, llama.cpp server, ...
# The served model is auto-discovered via GET /v1/models (prefers the model
# currently loaded).
OPENAI_BASE_URL=http://<your-model-box>:8888/v1
OPENAI_API_KEY=sk-...

# Optional: inference-host identity (see poc/lib/model.mjs).
# PI_PROVIDER_ID — provider id registered with pi-ai (default "aurora")
# PI_MODEL_ID   — explicit model id override (skips auto-discovery)
PI_PROVIDER_ID=
PI_MODEL_ID=

# --- Telegram bot (only needed for 06-telegram.mjs) -------------------------
# Create one: message @BotFather on Telegram -> /newbot -> follow the prompts.
# It replies with a token that looks like 123456789:AAH...
TELEGRAM_BOT_TOKEN=123456789:AAH...

# Access control: comma-separated numeric Telegram user IDs allowed to use the
# bot. Find yours by messaging @userinfobot (or any "get my id" bot).
# Empty = the first message binds as owner (PoC mode only — always set this
# for real use; see README "Creating the Telegram bot").
ALLOWED_TELEGRAM_IDS=

# Model catalog (see src/model.ts and docs/plans/model-catalog.md).
#
# Built-in pi providers (opencode-go, openrouter, …) are always registered; their
# credentials come from the global pi config's auth.json (no key duplication here).
# Custom providers come from the global pi config's models.json (e.g. local
# Unsloth hosts). PI_AGENT_DIR points at that config dir (default ~/.pi/agent).
PI_AGENT_DIR=
#
# Global default model: <provider>:<modelId> (split on the FIRST colon — model ids
# may contain "/"). Unset → falls back to the loaded model on the local endpoint below.
DEFAULT_MODEL=

# Legacy env-driven OpenAI-compatible endpoint (Unsloth on Aurora). Still used when
# models.json does not declare a provider with the same id as PI_PROVIDER_ID,
# and always feeds the default-model fallback via /v1/models discovery.
OPENAI_BASE_URL=http://localhost:8000/v1
OPENAI_API_KEY=local
# Optional inference-host identity (see src/model.ts):
# PI_PROVIDER_ID — provider id registered with pi-ai (default "aurora")
PI_PROVIDER_ID=

# API server
API_TOKEN=change-me
HOST=127.0.0.1
PORT=8791

# Directories (defaults are relative to app/)
DATA_DIR=./data
WORK_ROOT=./work
KB_DIR=./kb
CONFIG_DIR=.

# Approval gating (docs/plans/approvals.md): app/gates.json declares risk tiers per tool.
# Legacy fallback when gates.json is absent: comma-separated tool names gated at "prompt" tier.
# The destructive-action guard is always on regardless of this config.
GATED_TOOLS=send_message

# Podman sandbox for code-gen/test conversations (D12–13).
# Conversations created with {"sandbox": true} run their code in a disposable
# container: no host env vars, egress limited to SANDBOX_NETWORK.
SANDBOX_IMAGE=docker.io/library/python:3.12-alpine
SANDBOX_NETWORK=none

# Compaction sizing (reserveTokens must exceed pi-ai's 4096-token safety margin)
RESERVE_TOKENS=16384
KEEP_RECENT_TOKENS=8192
BACKGROUND_TOKENS=8192

# Telegram client (optional — enabled when TELEGRAM_BOT_TOKEN is set)
# Create a bot via @BotFather → /newbot. Long polling only: no inbound ports.
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user IDs allowed to use the bot (empty = first message binds)
ALLOWED_TELEGRAM_IDS=
# Bot API base override (default https://api.telegram.org/bot<TOKEN>); used by tests
TELEGRAM_API_BASE=
